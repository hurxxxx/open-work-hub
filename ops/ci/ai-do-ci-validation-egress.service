[Unit]
Description=AI-DO CI validation network egress policy
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ai-do-ci-validation-egress --apply
ExecReload=/usr/local/sbin/ai-do-ci-validation-egress --apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
