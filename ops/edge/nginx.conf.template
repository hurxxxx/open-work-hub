map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${OPEN_WORK_HUB_EDGE_LISTEN_PORT} default_server;
  server_name _;
  return 421;
}

server {
  listen ${OPEN_WORK_HUB_EDGE_LISTEN_PORT};
  server_name ${OPEN_WORK_HUB_EDGE_PROD_HOST};

  location / {
    proxy_pass http://127.0.0.1:${OPEN_WORK_HUB_EDGE_PROD_UPSTREAM_PORT};
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}

server {
  listen ${OPEN_WORK_HUB_EDGE_LISTEN_PORT};
  server_name ${OPEN_WORK_HUB_EDGE_DEV_HOST};

  location / {
    proxy_pass http://127.0.0.1:${OPEN_WORK_HUB_EDGE_DEV_UPSTREAM_PORT};
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}
