[Unit]
Description=Private Codex development console
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/owh-codex-console/current/apps/codex-console-api
EnvironmentFile=%h/.config/owh-codex-console/console.env
ExecStart=%h/.local/share/owh-codex-console/current/apps/codex-console-api/.venv/bin/codex-console serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
# Native YOLO turns must retain the service account's existing sudo/group privileges.
# Plan and approval-based turns are still sandboxed by the official Codex app-server.
NoNewPrivileges=false

[Install]
WantedBy=default.target
