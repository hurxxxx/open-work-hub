# Include inside the existing HTTPS server block. Preserve the full path.
# Console ORIGIN must match this HTTPS origin; BASE_PATH=/codex-console.
location = /codex-console {
    return 308 /codex-console/;
}
location /codex-console/ {
    client_max_body_size 50m;
    client_body_timeout 120s;
    proxy_pass http://127.0.0.1:19365;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_send_timeout 120s;
    proxy_read_timeout 3600s;
}
