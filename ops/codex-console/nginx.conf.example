# Replace hostname and certificate paths for the private console host.
server {
    listen 443 ssl;
    server_name codex.example.com;
    ssl_certificate /etc/letsencrypt/live/codex.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/codex.example.com/privkey.pem;

    # Match the console's configured per-file limit; ordinary JSON stays capped by the API.
    client_max_body_size 50m;
    client_body_timeout 120s;
    location / {
        proxy_pass http://127.0.0.1:19365;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_send_timeout 120s;
        proxy_read_timeout 3600s;
    }
}
