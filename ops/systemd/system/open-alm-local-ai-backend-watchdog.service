[Unit]
Description=Open ALM inference gateway active-hang watchdog
After=network-online.target open-alm-local-ai-backend.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/srv/local-ai-backend/local-ai.env
EnvironmentFile=-/etc/open-alm/inference-gateway-watchdog.env
Environment=OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_FAILURE_THRESHOLD=3
Environment=OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_PROBE_TIMEOUT_SECONDS=8
Environment=OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_STARTUP_GRACE_SECONDS=240
ExecStart=/usr/local/sbin/open-alm-local-ai-backend-watchdog
