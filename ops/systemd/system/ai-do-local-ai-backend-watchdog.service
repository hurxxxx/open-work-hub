[Unit]
Description=AI-DO inference gateway active-hang watchdog
After=network-online.target ai-do-local-ai-backend.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/srv/local-ai-backend/local-ai.env
EnvironmentFile=-/etc/ai-do/inference-gateway-watchdog.env
Environment=AI_DO_INFERENCE_GATEWAY_WATCHDOG_FAILURE_THRESHOLD=3
Environment=AI_DO_INFERENCE_GATEWAY_WATCHDOG_PROBE_TIMEOUT_SECONDS=8
Environment=AI_DO_INFERENCE_GATEWAY_WATCHDOG_STARTUP_GRACE_SECONDS=240
ExecStart=/usr/local/sbin/ai-do-local-ai-backend-watchdog
