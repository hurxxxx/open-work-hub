#!/usr/bin/env bash
set -euo pipefail

service_name="${OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_SERVICE:-open-alm-local-ai-backend.service}"
port="${OPEN_ALM_LOCAL_AI_PORT:-18080}"
health_url="${OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_URL:-http://127.0.0.1:${port}/health}"
failure_threshold="${OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_FAILURE_THRESHOLD:-3}"
probe_timeout_seconds="${OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_PROBE_TIMEOUT_SECONDS:-8}"
startup_grace_seconds="${OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_STARTUP_GRACE_SECONDS:-240}"
peer_health_url="${OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_PEER_URL:-}"
allow_uncoordinated_restart="${OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_ALLOW_UNCOORDINATED_RESTART:-false}"
maintenance_file="${OPEN_ALM_INFERENCE_GATEWAY_WATCHDOG_MAINTENANCE_FILE:-/etc/open-alm/inference-gateway-watchdog.disabled}"
state_dir="/run/open-alm-inference-gateway-watchdog"
failure_file="${state_dir}/failures"

mkdir -p "$state_dir"

if [[ -e "$maintenance_file" ]]; then
  rm -f "$failure_file"
  exit 0
fi

request_restart() {
  local reason="$1"
  local peer_payload=""

  if [[ -n "$peer_health_url" ]] \
    && peer_payload="$(curl --fail --silent --show-error \
      --max-time "$probe_timeout_seconds" \
      "$peer_health_url")" \
    && grep -Eq '"ready"[[:space:]]*:[[:space:]]*true' <<<"$peer_payload"; then
    logger -t open-alm-inference-watchdog \
      "$reason; peer is serving, requesting local restart"
    systemctl restart "$service_name"
    return 0
  fi

  if [[ "$allow_uncoordinated_restart" == "true" ]]; then
    logger -t open-alm-inference-watchdog \
      "$reason; peer is unavailable, priority node requesting local restart"
    systemctl restart "$service_name"
    return 0
  fi

  logger -t open-alm-inference-watchdog \
    "$reason; peer is unavailable, deferring local restart"
  return 1
}

active_state="$(systemctl show "$service_name" --property=ActiveState --value)"
if [[ "$active_state" != "active" ]]; then
  if request_restart "$service_name is $active_state"; then
    rm -f "$failure_file"
  fi
  exit 0
fi

started_us="$(systemctl show "$service_name" --property=ActiveEnterTimestampMonotonic --value)"
uptime_seconds="$(cut -d' ' -f1 /proc/uptime)"
now_us="$(awk -v seconds="$uptime_seconds" 'BEGIN { printf "%.0f", seconds * 1000000 }')"
if [[ "$started_us" =~ ^[0-9]+$ ]] \
  && (( now_us - started_us < startup_grace_seconds * 1000000 )); then
  rm -f "$failure_file"
  exit 0
fi

health_payload=""
if health_payload="$(curl --fail --silent --show-error \
  --max-time "$probe_timeout_seconds" \
  "$health_url")" \
  && grep -Eq '"ready"[[:space:]]*:[[:space:]]*true' <<<"$health_payload"; then
  rm -f "$failure_file"
  exit 0
fi

failures=0
if [[ -f "$failure_file" ]]; then
  read -r failures <"$failure_file" || failures=0
fi
if [[ ! "$failures" =~ ^[0-9]+$ ]]; then
  failures=0
fi
failures=$((failures + 1))
printf '%s\n' "$failures" >"$failure_file"

logger -t open-alm-inference-watchdog \
  "$service_name health probe failed ($failures/$failure_threshold): $health_url"

if (( failures < failure_threshold )); then
  exit 0
fi

if request_restart "$service_name remained unhealthy"; then
  rm -f "$failure_file"
fi
