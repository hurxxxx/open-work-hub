[Unit]
Description=AI-DO Production API
Wants=network-online.target ai-do-prod-infra.service ai-do-privacy-filter.service
After=network-online.target ai-do-prod-infra.service ai-do-privacy-filter.service

[Service]
Type=simple
Environment=AI_DO_RUNTIME_REVISION=__AI_DO_RUNTIME_REVISION__
WorkingDirectory=__AI_DO_ROOT__/apps/api
Environment=AI_DO_API_AUTO_MIGRATE=0
Environment=AI_DO_API_INSTANCE_ID=prod-api
Environment=AI_DO_API_SERVE_FRONTEND=1
ExecStart=__AI_DO_ROOT__/apps/api/.venv/bin/python -m uvicorn ai_do_api.main:app --app-dir src --host 0.0.0.0 --port 8000
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=180
KillMode=control-group

[Install]
WantedBy=default.target
