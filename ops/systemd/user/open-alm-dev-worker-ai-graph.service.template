[Unit]
Description=Open ALM Development Worker - Durable AI Graph
Wants=network-online.target open-alm-dev-app.service
After=network-online.target open-alm-dev-app.service

[Service]
Type=simple
WorkingDirectory=__OPEN_ALM_ROOT__/apps/worker
Environment=PYTHONPATH=__OPEN_ALM_ROOT__/apps/worker/src
Environment=OPEN_ALM_WORKER_QUEUE_GROUP=ai_graph
Environment=OPEN_ALM_RUNTIME_REVISION=__OPEN_ALM_RUNTIME_REVISION__
ExecStart=/usr/bin/env bash -lc 'source "__OPEN_ALM_ROOT__/scripts/dev-env.sh" && cd "__OPEN_ALM_ROOT__/apps/worker" && exec uv run --python 3.12 celery -A open_alm_worker.celery_app:celery_app worker --loglevel=info --hostname=open-alm-dev-worker-ai-graph@%H -Q __OPEN_ALM_WORKER_AI_GRAPH_QUEUE_NAMES__ --concurrency __OPEN_ALM_WORKER_AI_GRAPH_CONCURRENCY__ --prefetch-multiplier 1'
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=1500
KillMode=mixed

[Install]
WantedBy=default.target
