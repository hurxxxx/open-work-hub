[Unit]
Description=AI-DO Development App
Wants=network-online.target ai-do-privacy-filter.service
After=network-online.target ai-do-privacy-filter.service

[Service]
Type=simple
Environment=AI_DO_RUNTIME_REVISION=__AI_DO_RUNTIME_REVISION__
WorkingDirectory=__AI_DO_ROOT__
ExecStart=__AI_DO_ROOT__/dev.sh --plain-logs
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120
KillMode=control-group

[Install]
WantedBy=default.target
