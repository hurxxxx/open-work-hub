[Unit]
Description=Open ALM Production Collaboration WebSocket API
Wants=network-online.target open-alm-prod-infra.service open-alm-privacy-filter.service
After=network-online.target open-alm-prod-infra.service open-alm-privacy-filter.service

[Service]
Type=simple
Environment=OPEN_ALM_RUNTIME_REVISION=__OPEN_ALM_RUNTIME_REVISION__
WorkingDirectory=__OPEN_ALM_ROOT__/apps/api
Environment=OPEN_ALM_API_AUTO_MIGRATE=0
Environment=OPEN_ALM_API_INSTANCE_ID=prod-collab
Environment=OPEN_ALM_API_SERVE_FRONTEND=0
ExecStart=__OPEN_ALM_ROOT__/apps/api/.venv/bin/python -m uvicorn open_alm_api.main:app --app-dir src --host 127.0.0.1 --port 8009
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=180
KillMode=control-group

[Install]
WantedBy=default.target
