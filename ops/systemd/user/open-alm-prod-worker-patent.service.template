[Unit]
Description=Open ALM Production Worker - Patent Prior Art
Wants=network-online.target open-alm-prod-infra.service open-alm-prod-api.service
After=network-online.target open-alm-prod-infra.service open-alm-prod-api.service
PartOf=open-alm-prod-api.service

[Service]
Type=simple
ExecCondition=/usr/bin/test -f __OPEN_ALM_ROOT__/ops/systemd/user/open-alm-prod-worker-patent.service.template
WorkingDirectory=__OPEN_ALM_ROOT__/apps/worker
Environment=PYTHONPATH=__OPEN_ALM_ROOT__/apps/worker/src
Environment=OPEN_ALM_WORKER_QUEUE_GROUP=patent
Environment=OPEN_ALM_RUNTIME_REVISION=__OPEN_ALM_RUNTIME_REVISION__
ExecStart=__OPEN_ALM_ROOT__/apps/worker/.venv/bin/python -m celery -A open_alm_worker.celery_app:celery_app worker --loglevel=info --hostname=open-alm-prod-worker-patent@%H -Q __OPEN_ALM_WORKER_PATENT_QUEUE_NAMES__ --concurrency __OPEN_ALM_WORKER_PATENT_CONCURRENCY__ --prefetch-multiplier 1
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=3900
KillMode=mixed

[Install]
WantedBy=default.target
