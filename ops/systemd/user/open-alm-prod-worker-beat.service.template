[Unit]
Description=Open ALM Production Worker Beat
Wants=network-online.target open-alm-prod-infra.service open-alm-prod-worker.service open-alm-prod-worker-realtime.service open-alm-prod-worker-long.service open-alm-prod-worker-patent.service open-alm-prod-worker-ai-graph.service
After=network-online.target open-alm-prod-infra.service open-alm-prod-worker.service open-alm-prod-worker-realtime.service open-alm-prod-worker-long.service open-alm-prod-worker-patent.service open-alm-prod-worker-ai-graph.service

[Service]
Type=simple
WorkingDirectory=__OPEN_ALM_ROOT__/apps/worker
Environment=PYTHONPATH=__OPEN_ALM_ROOT__/apps/worker/src
Environment=OPEN_ALM_WORKER_QUEUE_GROUP=beat
Environment=OPEN_ALM_RUNTIME_REVISION=__OPEN_ALM_RUNTIME_REVISION__
ExecStart=__OPEN_ALM_ROOT__/apps/worker/.venv/bin/python -m celery -A open_alm_worker.celery_app:celery_app beat --loglevel=info --schedule __OPEN_ALM_ROOT__/.runtime/celerybeat-schedule.db
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=180
KillMode=control-group

[Install]
WantedBy=default.target
