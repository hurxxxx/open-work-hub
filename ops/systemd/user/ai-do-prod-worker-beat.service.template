[Unit]
Description=AI-DO Production Worker Beat
Wants=network-online.target ai-do-prod-infra.service ai-do-prod-worker.service ai-do-prod-worker-realtime.service ai-do-prod-worker-long.service ai-do-prod-worker-patent.service ai-do-prod-worker-ai-graph.service
After=network-online.target ai-do-prod-infra.service ai-do-prod-worker.service ai-do-prod-worker-realtime.service ai-do-prod-worker-long.service ai-do-prod-worker-patent.service ai-do-prod-worker-ai-graph.service

[Service]
Type=simple
WorkingDirectory=__AI_DO_ROOT__/apps/worker
Environment=PYTHONPATH=__AI_DO_ROOT__/apps/worker/src
Environment=AI_DO_WORKER_QUEUE_GROUP=beat
Environment=AI_DO_RUNTIME_REVISION=__AI_DO_RUNTIME_REVISION__
ExecStart=__AI_DO_ROOT__/apps/worker/.venv/bin/python -m celery -A ai_do_worker.celery_app:celery_app beat --loglevel=info --schedule __AI_DO_ROOT__/.runtime/celerybeat-schedule.db
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=180
KillMode=control-group

[Install]
WantedBy=default.target
