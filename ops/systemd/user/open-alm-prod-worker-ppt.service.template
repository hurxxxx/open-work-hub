[Unit]
Description=Open ALM Production Worker - PPT Generation Queue
Wants=network-online.target open-alm-prod-infra.service open-alm-prod-api.service
After=network-online.target open-alm-prod-infra.service open-alm-prod-api.service

[Service]
Type=simple
WorkingDirectory=__OPEN_ALM_ROOT__/apps/worker
Environment=PYTHONPATH=__OPEN_ALM_ROOT__/apps/worker/src
Environment=OPEN_ALM_WORKER_QUEUE_GROUP=ppt
Environment=OPEN_ALM_RUNTIME_REVISION=__OPEN_ALM_RUNTIME_REVISION__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/dev/null
ExecStartPre=__OPEN_ALM_ROOT__/apps/worker/.venv/bin/python -m open_alm_worker.ppt_browser_smoke
ExecStart=__OPEN_ALM_ROOT__/apps/worker/.venv/bin/python -m celery -A open_alm_worker.celery_app:celery_app worker --loglevel=info --hostname=open-alm-prod-worker-ppt@%H -Q __OPEN_ALM_WORKER_PPT_QUEUE_NAMES__ --concurrency __OPEN_ALM_WORKER_PPT_CONCURRENCY__ --prefetch-multiplier 1
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=3900
KillMode=mixed

[Install]
WantedBy=default.target
