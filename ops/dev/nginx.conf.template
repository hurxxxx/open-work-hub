map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream corporate_api_cluster {
  server __OPEN_WORK_HUB_DEV_API_UPSTREAM_HOST__:8001;
  server __OPEN_WORK_HUB_DEV_API_UPSTREAM_HOST__:8002;
  server __OPEN_WORK_HUB_DEV_API_UPSTREAM_HOST__:8003;
  server __OPEN_WORK_HUB_DEV_API_UPSTREAM_HOST__:8004;
  server __OPEN_WORK_HUB_DEV_API_UPSTREAM_HOST__:8005;
  server __OPEN_WORK_HUB_DEV_API_UPSTREAM_HOST__:8006;
  server __OPEN_WORK_HUB_DEV_API_UPSTREAM_HOST__:8007;
  server __OPEN_WORK_HUB_DEV_API_UPSTREAM_HOST__:8008;
}

server {
  listen __OPEN_WORK_HUB_DEV_NGINX_LISTEN_PORT__;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location = /drawio {
    return 301 /drawio/;
  }

  location /drawio/ {
    proxy_pass http://drawio:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /drawio;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
  }

  location /api/ {
    proxy_pass http://corporate_api_cluster;
    proxy_http_version 1.1;
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries 8;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
