{
  "name": "ai-do-portal",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "nx": "env -u NO_COLOR -u NODE_ENV nx",
    "check:project-version": "node scripts/check-project-version.mjs",
    "dev": "./dev.sh",
    "dev:web": "nx dev web",
    "dev:api": "nx dev api",
    "dev:worker": "nx dev worker",
    "dev:ops": "nx dev ops",
    "build:web": "nx build web",
    "prod:install": "bash ./scripts/prod-systemd.sh install",
    "prod:start": "bash ./scripts/prod-systemd.sh start",
    "prod:stop": "bash ./scripts/prod-systemd.sh stop",
    "prod:status": "bash ./scripts/prod-systemd.sh status",
    "prod:logs": "bash ./scripts/prod-systemd.sh log",
    "prod:restart": "bash ./scripts/prod-systemd.sh restart",
    "prod:smoke": "bash ./scripts/prod-systemd.sh smoke",
    "prod:deploy": "bash ./scripts/prod-deploy.sh",
    "test:prod-deploy": "python3 -m unittest scripts.tests.test_prod_deploy_script",
    "infra:prod:up": "bash ./scripts/infra-stack.sh prod up",
    "infra:prod:down": "bash ./scripts/infra-stack.sh prod down",
    "infra:prod:status": "bash ./scripts/infra-stack.sh prod ps",
    "infra:dev:up": "bash ./scripts/infra-stack.sh dev up",
    "infra:dev:down": "bash ./scripts/infra-stack.sh dev down",
    "infra:dev:status": "bash ./scripts/infra-stack.sh dev ps",
    "inference-gateway:sync": "bash ./scripts/inference-gateway-service.sh sync",
    "inference-gateway:install": "bash ./scripts/inference-gateway-service.sh install-user-service",
    "inference-gateway:enable": "bash ./scripts/inference-gateway-service.sh enable",
    "inference-gateway:start": "bash ./scripts/inference-gateway-service.sh start",
    "inference-gateway:stop": "bash ./scripts/inference-gateway-service.sh stop",
    "inference-gateway:restart": "bash ./scripts/inference-gateway-service.sh restart",
    "inference-gateway:logs": "bash ./scripts/inference-gateway-service.sh logs",
    "inference-gateway:status": "bash ./scripts/inference-gateway-service.sh status",
    "inference-gateway:health": "bash ./scripts/inference-gateway-service.sh health",
    "inference-gateway:smoke": "bash ./scripts/inference-gateway-smoke.sh",
    "dev:infra:up": "bash ./scripts/dev-infra.sh up",
    "dev:infra:down": "bash ./scripts/dev-infra.sh down",
    "dev:install": "bash ./scripts/dev-systemd.sh install",
    "dev:systemd:status": "bash ./scripts/dev-systemd.sh status",
    "dev:web:build": "nx build web",
    "dev:api:1": "bash ./scripts/dev-api.sh 8001",
    "dev:api:2": "bash ./scripts/dev-api.sh 8002",
    "dev:smoke": "bash ./scripts/dev-smoke.sh",
    "check:app-platform-guardrails": "node scripts/check-app-platform-guardrails.mjs",
    "check:app-platform-guardrails:artifact": "node scripts/check-app-platform-guardrails.mjs --json --output app-platform-guardrails.json",
    "test:app-platform-guardrails": "node --test scripts/check-app-platform-guardrails.test.mjs scripts/api-test-selection.test.mjs",
    "check:mr-contract-evidence": "node scripts/check-mr-contract-evidence.mjs",
    "test:mr-contract-evidence": "node --test scripts/check-mr-contract-evidence.test.mjs",
    "test:codex-review-contract": "uv run --python 3.12 python scripts/tests/test_check_codex_review_ci.py",
    "test:api-ci-runtime": "python3 -m unittest scripts.tests.test_check_api_test_budget && bash scripts/ci/run-api-pytest.test.sh && bash scripts/ci/build-ci-validation-image.test.sh",
    "check:alembic-graph": "uv run --python 3.12 python scripts/check-alembic-state.py --api-root apps/api --static-graph-only",
    "test:alembic-graph": "uv run --python 3.12 python scripts/tests/test_check_alembic_state.py",
    "check:python-source-integrity": "uv run --python 3.12 python scripts/check-python-source-integrity.py",
    "test:python-source-integrity": "uv run --python 3.12 python scripts/tests/test_check_python_source_integrity.py",
    "test:api-i18n-checker": "uv run --python 3.12 python scripts/tests/test_api_i18n_message_checker.py",
    "check:core-web-boundaries": "node scripts/check-core-web-boundaries.mjs",
    "check:web-boundaries": "node scripts/check-web-app-boundaries.mjs",
    "check:api-i18n": "uv run --python 3.12 python scripts/check-api-i18n-messages.py",
    "check:web-i18n": "node scripts/check-web-i18n-messages.mjs --fail-on-findings",
    "check:web-dark-mode": "node scripts/check-web-dark-mode-tokens.mjs",
    "check:i18n": "pnpm check:api-i18n && pnpm check:web-i18n",
    "check:path-hardcoding": "bash ./scripts/check-path-hardcoding.sh",
    "docs:final:build": "node docs/final/ai-do-project-completion-2026-08-05/generator/generate.mjs",
    "docs:final:check": "node docs/final/ai-do-project-completion-2026-08-05/generator/generate.mjs --check",
    "test:final-docs": "node --test docs/final/ai-do-project-completion-2026-08-05/generator/generate.test.mjs",
    "check:api-test-budget": "pnpm nx run api:test-budget --skip-nx-cache",
    "check:mr-target-policy": "node scripts/check-mr-target-policy.mjs",
    "test:mr-target-policy": "node --test scripts/check-mr-target-policy.test.mjs",
    "check:feature-mr-preflight-receipt": "node scripts/check-feature-mr-preflight-receipt.mjs",
    "mr:preflight": "node scripts/ci/feature-mr.mjs preflight",
    "mr:publish": "node scripts/ci/feature-mr.mjs publish",
    "test:feature-mr": "node --test scripts/ci/feature-mr.test.mjs",
    "check:env-contract": "python3 scripts/check-env-contract.py",
    "check:runtime-separation": "python3 scripts/check-runtime-separation.py",
    "check:runtime-separation:live": "python3 scripts/check-runtime-separation.py --mode live",
    "check:skills": "python3 scripts/check-skill-harness.py",
    "depcruise:web": "depcruise --config .dependency-cruiser.cjs --include-only '^apps/web/src' apps/web/src",
    "knip:web": "knip --config knip.json --include files,unresolved --reporter compact",
    "check:web-architecture": "pnpm check:web-boundaries && pnpm check:web-i18n && pnpm check:web-dark-mode && pnpm depcruise:web && pnpm knip:web",
    "generate:api-client": "node scripts/generate-openapi-client.mjs",
    "build:contracts": "pnpm --dir packages/contracts build",
    "build:core-web": "pnpm --dir packages/core-web build",
    "check:api-contract": "node scripts/generate-openapi-client.mjs --check",
    "check:contracts-sources": "node scripts/check-contract-source-artifacts.mjs",
    "check:api-architecture": "pnpm check:api-i18n && cd apps/api && uv run --python 3.12 --group dev lint-imports",
    "ci:api": "pnpm check:api-test-budget && pnpm check:api-architecture && pnpm nx lint api && pnpm nx typecheck api && pnpm nx test api",
    "ci:api:full": "pnpm check:api-architecture && pnpm nx lint api && pnpm nx typecheck api && pnpm nx run api:test-full",
    "ci:python-contract-guardrails": "pnpm test:alembic-graph && pnpm test:python-source-integrity && pnpm check:alembic-graph && pnpm check:python-source-integrity && pnpm check:api-i18n",
    "ci:app-api-contracts": "uv lock --check --directory apps/api && uv lock --check --directory apps/worker && UV_PROJECT_ENVIRONMENT=../../.runtime/ci-api-venv uv sync --frozen --python 3.12 --group dev --directory apps/api && UV_PROJECT_ENVIRONMENT=../../.runtime/ci-worker-venv uv sync --frozen --python 3.12 --group dev --directory apps/worker && AI_DO_POSTGRES_DSN=postgresql+psycopg://contract:contract@127.0.0.1:1/ai_do_ci_contracts AI_DO_WORKER_QUEUE_GROUP=default pnpm nx run api:ci-contracts --parallel=6 --outputStyle=static --skip-nx-cache",
    "ci:app-web-contracts": "pnpm nx run-many -p web -t architecture,typecheck,test --parallel=3 --outputStyle=static --skip-nx-cache",
    "ci:contract": "pnpm check:api-contract && pnpm check:contracts-sources && pnpm nx typecheck contracts && pnpm nx test contracts && pnpm build:contracts",
    "ci:core-web": "pnpm check:core-web-boundaries && pnpm nx typecheck core-web && pnpm nx test core-web && pnpm nx build core-web",
    "ci:web": "pnpm ci:core-web && pnpm check:api-contract && pnpm check:web-architecture && pnpm nx typecheck web && pnpm nx lint web && pnpm nx test web && pnpm nx build web && pnpm nx e2e-shell web",
    "ci:harness": "pnpm nx run ci-harness:ci --parallel=4 --outputStyle=static --skip-nx-cache",
    "ci:all": "pnpm ci:python-contract-guardrails && pnpm ci:harness && pnpm ci:contract && pnpm ci:api && pnpm ci:web",
    "test:api:vm": "bash scripts/api-test-vm.sh",
    "test:api:vm:collect": "bash scripts/api-test-vm.sh --collect-only",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "agent-browser:smoke": "pnpm nx e2e-shell web",
    "e2e": "playwright test --config apps/web/playwright.config.ts",
    "e2e:shell": "playwright test --config apps/web/playwright.config.ts apps/web/e2e/app-boundary-smoke.spec.ts",
    "e2e:ui": "playwright test --config apps/web/playwright.config.ts --ui",
    "e2e:install": "playwright install chromium"
  },
