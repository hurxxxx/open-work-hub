{
  "name": "aidoo-portal",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "nx": "env -u NO_COLOR -u NODE_ENV nx",
    "dev": "./dev.sh",
    "dev:web": "nx dev web",
    "dev:api": "nx dev api",
    "dev:worker": "nx dev worker",
    "dev:ops": "nx dev ops",
    "build:web": "nx build web",
    "prod:start": "bash ./prod.sh start",
    "prod:stop": "bash ./prod.sh stop",
    "prod:status": "bash ./prod.sh status",
    "prod:logs": "bash ./prod.sh log",
    "prod:restart": "bash ./prod.sh restart",
    "prod:smoke": "bash ./prod.sh smoke",
    "dev:infra:up": "bash ./scripts/dev-infra.sh up",
    "dev:infra:down": "bash ./scripts/dev-infra.sh down",
    "dev:web:build": "nx build web",
    "dev:api:1": "bash ./scripts/dev-api.sh 8001",
    "dev:api:2": "bash ./scripts/dev-api.sh 8002",
    "dev:smoke": "bash ./scripts/dev-smoke.sh",
    "fix:codex-issue-16849": "bash ./scripts/apply-codex-issue-16849-fix.sh",
    "check:web-boundaries": "node scripts/check-web-app-boundaries.mjs",
    "depcruise:web": "depcruise --config .dependency-cruiser.cjs --include-only '^apps/web/src' apps/web/src",
    "knip:web": "knip --config knip.json --include files,unresolved --reporter compact",
    "check:web-architecture": "pnpm check:web-boundaries && pnpm depcruise:web && pnpm knip:web",
    "generate:api-client": "node scripts/generate-openapi-client.mjs",
    "check:api-contract": "node scripts/generate-openapi-client.mjs --check",
    "check:api-architecture": "cd apps/api && uv run --python 3.12 --group dev lint-imports",
    "ci:api": "pnpm check:api-architecture && pnpm nx lint api && pnpm nx typecheck api && pnpm nx test api",
    "ci:contract": "pnpm check:api-contract",
    "ci:web": "pnpm check:api-contract && pnpm check:web-architecture && pnpm nx typecheck web && pnpm nx lint web && pnpm nx test web && pnpm nx build web && pnpm nx e2e-shell web",
    "ci:all": "pnpm ci:contract && pnpm ci:api && pnpm ci:web",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "e2e": "playwright test --config apps/web/playwright.config.ts",
    "e2e:shell": "playwright test --config apps/web/playwright.config.ts apps/web/e2e/app-boundary-smoke.spec.ts",
    "e2e:ui": "playwright test --config apps/web/playwright.config.ts --ui",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.6.4",
    "@nx/eslint-plugin": "22.6.4",
    "@nx/js": "^22.6.4",
    "@nx/react": "^22.6.4",
    "@nx/vite": "^22.6.4",
    "@nx/vitest": "22.6.4",
    "@nx/web": "22.6.4",
    "@playwright/test": "^1.59.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "knip": "^6.9.0",
    "nx": "^22.6.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "~3.6.2",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "7.3.1",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "@blocknote/core": "^0.47.3",
    "@blocknote/mantine": "^0.47.3",
    "@blocknote/react": "^0.47.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/luxon3": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hyunbinseo/holidays-kr": "^4.2026.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.0",
    "eventsource-parser": "^3.0.7",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  }
}
