{
  "name": "ci-harness",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:tooling", "type:ci"],
  "targets": {
    "project-version": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:project-version" }
    },
    "mr-target-policy-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm test:mr-target-policy" }
    },
    "app-platform-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm test:app-platform-guardrails" }
    },
    "mr-contract-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm test:mr-contract-evidence" }
    },
    "codex-contract-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm test:codex-review-contract" }
    },
    "api-ci-runtime-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm test:api-ci-runtime" }
    },
    "feature-mr-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm test:feature-mr" }
    },
    "prod-deploy-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm test:prod-deploy" }
    },
    "app-platform-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:app-platform-guardrails" }
    },
    "mr-contract-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:mr-contract-evidence" }
    },
    "web-i18n": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:web-i18n" }
    },
    "web-dark-mode": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:web-dark-mode" }
    },
    "env-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:env-contract" }
    },
    "runtime-separation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:runtime-separation" }
    },
    "skills": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:skills" }
    },
    "path-hardcoding": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm check:path-hardcoding" }
    },
    "final-doc-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm test:final-docs" }
    },
    "final-doc-drift": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": ".", "command": "pnpm docs:final:check" }
    },
    "ci": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "project-version",
        "mr-target-policy-tests",
        "app-platform-tests",
        "mr-contract-tests",
        "codex-contract-tests",
        "api-ci-runtime-tests",
        "feature-mr-tests",
        "prod-deploy-tests",
        "app-platform-check",
        "mr-contract-check",
        "web-i18n",
        "web-dark-mode",
        "env-contract",
        "runtime-separation",
        "skills",
        "path-hardcoding",
        "final-doc-tests",
        "final-doc-drift"
      ]
    }
  }
}
