    "ConversationAttachedData": {
      "description": "Emitted once at stream start so the client learns which persisted\nconversation row its turns are being appended to.\n\nAlways precedes the first ``content_delta``/``reasoning_delta`` so a UI\nthat tracks conversation ids can bind the id before any rendering begins.",
      "properties": {
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        }
      },
      "required": [
        "conversation_id"
      ],
      "title": "ConversationAttachedData",
      "type": "object"
    },
    "ConversationAttachedEvent": {
      "properties": {
        "data": {
          "$ref": "#/$defs/ConversationAttachedData"
