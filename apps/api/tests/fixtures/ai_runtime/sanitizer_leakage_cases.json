{
  "schema_version": 1,
  "suite": "sanitizer_leakage",
  "description": "Synthetic external-search sanitizer cases for generic secret and internal-identifier gates.",
  "cases": [
    {
      "id": "sanitizer-internal-identifier",
      "locale": "ko-KR",
      "synthetic": true,
      "tags": ["external_search", "deny_by_default"],
      "input": {
        "user_message": "INTERNAL-PROJECT-2400 공개 접근성 요구사항을 검색해줘.",
        "detected_entities": ["internal_identifier"]
      },
      "expected": {
        "allow_external": true,
        "removed_entity_types": ["internal_identifier"],
        "sanitized_query": "공개 접근성 요구사항을 검색해줘"
      }
    },
    {
      "id": "sanitizer-credential",
      "locale": "ko-KR",
      "synthetic": true,
      "tags": ["external_search", "blocked"],
      "input": {
        "user_message": "API_KEY=sk-test-secret 를 포함해서 공개 자료를 검색해줘.",
        "detected_entities": ["credential"]
      },
      "expected": {
        "allow_external": false,
        "removed_entity_types": ["credential"],
        "sanitized_query": ""
      }
    }
  ]
}
