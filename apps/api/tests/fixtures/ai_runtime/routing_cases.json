{
  "schema_version": 1,
  "suite": "routing",
  "description": "Synthetic Korean routing cases for scope and size driven runtime gates.",
  "cases": [
    {
      "id": "routing-meeting-scoped-summary",
      "locale": "ko-KR",
      "synthetic": true,
      "tags": ["meeting", "fast_path", "interactive_read"],
      "input": {
        "user_message": "이 회의의 결정사항만 요약해줘.",
        "allowed_app_ids": ["meeting"],
        "conversation_scope": {
          "kind": "meeting",
          "ref": "fixture-meeting-001"
        }
      },
      "expected": {
        "route": "fast_path",
        "runtime_profile": "interactive_read",
        "domains": ["meeting"],
        "requires_external": false
      }
    },
    {
      "id": "routing-cross-domain-report",
      "locale": "ko-KR",
      "synthetic": true,
      "tags": ["pms", "docs", "graph_path", "grounded_report"],
      "input": {
        "user_message": "가상 프로젝트 A의 이슈와 관련 문서를 함께 보고 리스크 보고서 초안을 만들어줘.",
        "allowed_app_ids": ["pms", "docs", "chatbot"],
        "conversation_scope": {
          "kind": "workspace",
          "ref": "fixture-workspace"
        }
      },
      "expected": {
        "route": "graph_path",
        "runtime_profile": "grounded_report",
        "domains": ["pms", "docs"],
        "requires_external": false
      }
    }
  ]
}
