[importlinter]
root_package = ai_do_api

[importlinter:contract:routers_are_composition_only]
name = Router modules are imported only by the API composition registry
type = protected
protected_modules =
    ai_do_api.domains.*.router
    ai_do_api.domains.auth.workspace_router
allowed_importers =
    ai_do_api.api_registry
    ai_do_api.installed_extension_apps
as_packages = false

[importlinter:contract:domains_do_not_import_composition_roots]
name = Domain modules do not import API composition roots
type = forbidden
source_modules =
    ai_do_api.domains
forbidden_modules =
    ai_do_api.app
    ai_do_api.main
    ai_do_api.api_registry
