{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "DOOWON_API_AUTO_MIGRATE=1 uv run --python 3.12 uvicorn ai_do_api.main:app --app-dir src --host 127.0.0.1 --port 8000 --reload"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 uvicorn ai_do_api.main:app --app-dir src --host 127.0.0.1 --port 8000"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 --group dev ruff check ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 --group dev python -m pytest"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 python -m compileall src"
      }
    },
    "architecture": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/check-api-i18n-messages.py",
        "{projectRoot}/.importlinter"
      ],
      "options": {
        "cwd": ".",
        "command": "pnpm check:api-architecture"
      }
    }
  }
}
