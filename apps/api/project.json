{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "env -u OPENROUTER_API_KEY OPEN_WORK_HUB_API_AUTO_MIGRATE=${OPEN_WORK_HUB_API_AUTO_MIGRATE:-1} uv run --python 3.12 uvicorn open_work_hub_api.main:app --app-dir src --host ${OPEN_WORK_HUB_DEV_API_HOST:-127.0.0.1} --port ${OPEN_WORK_HUB_API_DEV_PORT:-8001} --reload"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "env -u OPENROUTER_API_KEY uv run --python 3.12 uvicorn open_work_hub_api.main:app --app-dir src --host 127.0.0.1 --port ${OPEN_WORK_HUB_API_DEV_PORT:-8001}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 --group dev ruff check ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 --group dev python -m pytest -n ${OPEN_WORK_HUB_API_PYTEST_WORKERS:-8} --dist=worksteal -m 'not slow and not external_integration and not migration'"
      }
    },
    "test-migrations": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 --group dev python -m pytest -m migration -q"
      }
    },
    "test-full": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "bash ../../scripts/ci/run-api-full-tests.sh"
      }
    },
    "test-slow": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 --group dev python -m pytest -m 'slow and not external_integration and not migration'"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "bash ../../scripts/api-test-vm.sh -m external_integration"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run --python 3.12 python -m compileall src"
      }
    },
    "architecture": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/check-api-i18n-messages.py",
        "{projectRoot}/.importlinter"
      ],
      "options": {
        "cwd": ".",
        "command": "pnpm check:api-architecture"
      }
    },
    "contract-openapi": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": ".",
        "command": "UV_PROJECT_ENVIRONMENT=../../.runtime/ci-api-venv node scripts/generate-openapi-client.mjs --check --no-sync"
      }
    },
    "contract-architecture": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": ".",
        "command": "python3 scripts/check-api-i18n-messages.py && cd apps/api && UV_PROJECT_ENVIRONMENT=../../.runtime/ci-api-venv uv run --no-sync --frozen --python 3.12 --group dev lint-imports"
      }
    },
    "contract-lint": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "UV_PROJECT_ENVIRONMENT=../../.runtime/ci-api-venv uv run --no-sync --frozen --python 3.12 --group dev ruff check ."
      }
    },
    "contract-typecheck": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "UV_PROJECT_ENVIRONMENT=../../.runtime/ci-api-venv uv run --no-sync --frozen --python 3.12 python -m compileall src"
      }
    },
    "contract-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/api",
        "command": "UV_PROJECT_ENVIRONMENT=../../.runtime/ci-api-venv uv run --no-sync --frozen --python 3.12 --group dev python -m pytest tests/test_platform_adapter_registries.py tests/test_workspace_keyword_search_registry.py tests/test_ai_gateway_direct_call_guard.py -q"
      }
    },
    "ci-contracts": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "contract-openapi",
        "contract-architecture",
        "contract-lint",
        "contract-typecheck",
        "contract-tests",
        {
          "projects": ["worker"],
          "target": "contract-tests"
        }
      ]
    }
  }
}
