{
  "name": "worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/worker/src",
  "projectType": "application",
  "tags": ["scope:worker", "type:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/worker",
        "command": "uv run --python 3.12 celery -A aidoo_worker.celery_app:celery_app worker --loglevel=info"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/worker",
        "command": "uv run --python 3.12 --group dev ruff check ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/worker",
        "command": "uv run --python 3.12 python -m compileall src"
      }
    }
  }
}
