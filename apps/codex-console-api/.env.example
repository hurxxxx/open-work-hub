# Independent console settings. Do not use the OWH application database.
OPEN_WORK_HUB_CODEX_CONSOLE_DATABASE_URL=postgresql+psycopg://console:CHANGE_ME@127.0.0.1:5432/codex_console
OPEN_WORK_HUB_CODEX_CONSOLE_ORIGIN=https://codex.example.com
# Empty for a dedicated host, /codex-console behind the OWH HTTPS proxy.
OPEN_WORK_HUB_CODEX_CONSOLE_BASE_PATH=
OPEN_WORK_HUB_CODEX_CONSOLE_WORKSPACE=/absolute/path/to/open-work-hub/dev
OPEN_WORK_HUB_CODEX_CONSOLE_BINARY=codex
OPEN_WORK_HUB_CODEX_CONSOLE_BIND_HOST=127.0.0.1
OPEN_WORK_HUB_CODEX_CONSOLE_PORT=19365
OPEN_WORK_HUB_CODEX_CONSOLE_WEB_DIST=../codex-console-web/dist
OPEN_WORK_HUB_CODEX_CONSOLE_SESSION_HOURS=12
# Disposable read-only copies; originals are backed up with the dedicated PostgreSQL DB.
OPEN_WORK_HUB_CODEX_CONSOLE_ATTACHMENT_CACHE=~/.local/share/owh-codex-console/attachments
OPEN_WORK_HUB_CODEX_CONSOLE_ATTACHMENT_MAX_BYTES=52428800
OPEN_WORK_HUB_CODEX_CONSOLE_ATTACHMENT_TASK_MAX_BYTES=524288000
