{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["scope:web", "type:app"],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "architecture": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.dependency-cruiser.cjs",
        "{workspaceRoot}/knip.json",
        "{workspaceRoot}/scripts/check-web-app-boundaries.mjs",
        "{workspaceRoot}/tsconfig.web-boundaries.json"
      ],
      "options": {
        "command": "pnpm check:web-architecture",
        "cwd": "."
      }
    },
    "e2e-shell": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec playwright test --config apps/web/playwright.config.ts apps/web/e2e/app-boundary-smoke.spec.ts",
        "cwd": "."
      }
    },
    "e2e-live-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec playwright test --config apps/web/playwright.live.config.ts",
        "cwd": "."
      }
    }
  }
}
