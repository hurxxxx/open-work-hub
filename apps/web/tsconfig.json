{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "vitest"],
    "rootDir": "../..",
    "paths": {
      "@open-work-hub/contracts": ["../../packages/contracts/src/index.ts"],
      "@open-work-hub/contracts/openapi": [
        "../../packages/contracts/src/openapi.generated.d.ts"
      ],
      "@open-work-hub/contracts/*": ["../../packages/contracts/src/*"],
      "@open-work-hub/core-web": ["../../packages/core-web/src/index.ts"],
      "@open-work-hub/core-web/*": ["../../packages/core-web/src/*"],
      "@open-work-hub/ui": ["../../packages/ui/src/index.ts"],
      "@open-work-hub/ui/*": ["../../packages/ui/src/lib/*"],
      "@open-work-hub/ui/styles.css": ["../../packages/ui/styles.css"],
      "@/src/*": ["./src/*"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.e2e.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
