{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "vitest"],
    "baseUrl": ".",
    "paths": {
      "@aidoo/ui": ["../../packages/ui/src/index.ts"],
      "@aidoo/ui/*": ["../../packages/ui/src/lib/*"],
      "@aidoo/ui/styles.css": ["../../packages/ui/styles.css"],
      "@/src/*": ["src/*"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.e2e.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
