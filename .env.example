OPEN_WORK_HUB_OPF_SERVICE_BASE_URL=http://127.0.0.1:18081
OPEN_WORK_HUB_OPF_SERVICE_TIMEOUT_MS=10000
OPEN_WORK_HUB_OPF_TIMEOUT_MS=10000

# Inference Gateway client and model diagnostics
OPEN_WORK_HUB_INFERENCE_GATEWAY_API_KEY=local
OPEN_WORK_HUB_INFERENCE_GATEWAY_BASE_URL=http://127.0.0.1:18080
OPEN_WORK_HUB_MODEL_STATUS_DIAGNOSTIC_TARGETS_JSON='[{"id":"local-model-a","display_name":"Local Model A","endpoint_url":"http://127.0.0.1:8000/v1","provider_id":"local","role":"redundancy"},{"id":"local-model-b","display_name":"Local Model B","endpoint_url":"http://127.0.0.1:8001/v1","provider_id":"local","role":"redundancy"}]'
OPEN_WORK_HUB_MODEL_STATUS_REQUEST_TIMEOUT_SECONDS=5

