OPEN_WORK_HUB_INFRA_NGINX_PORT=14200
OPEN_WORK_HUB_INFRA_OPENSEARCH_PERF_PORT=59610
OPEN_WORK_HUB_INFRA_OPENSEARCH_PORT=59210
OPEN_WORK_HUB_INFRA_POSTGRES_DB=open_work_hub_dev
OPEN_WORK_HUB_INFRA_POSTGRES_PASSWORD=open_work_hub_dev
OPEN_WORK_HUB_INFRA_POSTGRES_PORT=55433
OPEN_WORK_HUB_INFRA_POSTGRES_USER=open_work_hub_dev
OPEN_WORK_HUB_INFRA_QDRANT_API_KEY=open_work_hub_dev_qdrant
OPEN_WORK_HUB_INFRA_QDRANT_GRPC_PORT=16334
OPEN_WORK_HUB_INFRA_QDRANT_PORT=16333
OPEN_WORK_HUB_INFRA_REDIS_PORT=56380
OPEN_WORK_HUB_INFRA_USE_LOCAL_MINIO=auto
OPEN_WORK_HUB_INFRA_USE_LOCAL_POSTGRES=auto

# Application datastores, queues, and search services
OPEN_WORK_HUB_KEYWORD_SEARCH_BACKEND=opensearch
OPEN_WORK_HUB_MINIO_ACCESS_KEY=open_work_hub_dev_minio
OPEN_WORK_HUB_MINIO_BUCKET=open-work-hub-dev
OPEN_WORK_HUB_MINIO_ENDPOINT=http://127.0.0.1:59010
OPEN_WORK_HUB_MINIO_SECRET_KEY=open_work_hub_dev_minio
OPEN_WORK_HUB_OPENSEARCH_INDEX_PREFIX=open-work-hub-dev
OPEN_WORK_HUB_OPENSEARCH_URL=http://127.0.0.1:59210
OPEN_WORK_HUB_POSTGRES_DSN=postgresql+psycopg://open_work_hub_dev:open_work_hub_dev@127.0.0.1:55433/open_work_hub_dev
OPEN_WORK_HUB_WORKER_BROKER_URL=redis://127.0.0.1:56380/0
OPEN_WORK_HUB_WORKER_QUEUE_GROUP=all
OPEN_WORK_HUB_WORKER_RESULT_BACKEND=redis://127.0.0.1:56380/1

# Draw.io service
