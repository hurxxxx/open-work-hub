OPEN_WORK_HUB_AI_RUNTIME_SHADOW_WRITE_ENABLED=true
OPEN_WORK_HUB_AI_RUNTIME_TRACE_PAYLOAD_MAX_BYTES=32768
OPEN_WORK_HUB_AI_TOOL_CALLING_ENABLED=true
OPEN_WORK_HUB_AI_WRITE_TOOLS_ENABLED=false

# Open Privacy Filter
OPEN_WORK_HUB_OPF_CACHE_DIR=.runtime/opf-cache
OPEN_WORK_HUB_OPF_CHECKPOINT=openai/privacy-filter
OPEN_WORK_HUB_OPF_DEVICE=cpu
OPEN_WORK_HUB_OPF_DOWNLOAD_ON_STARTUP=true
OPEN_WORK_HUB_OPF_ENABLED=true
