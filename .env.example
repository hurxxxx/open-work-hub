# 아이두
# Copy this file to `.env` at the repository root and fill in real values.

# API app
DOOWON_API_APP_NAME=아이두 API
DOOWON_API_ENVIRONMENT=development
# local is the default. Use AIDOO_ENV_PROFILE=vm for VM-specific Docker fallback/host-network tests.
AIDOO_ENV_PROFILE=local
DOOWON_API_INSTANCE_ID=api
DOOWON_API_PREFIX=/api/v1
DOOWON_API_SESSION_TTL_HOURS=168

# Worker app
DOOWON_WORKER_BROKER_URL=redis://127.0.0.1:6379/0
DOOWON_WORKER_RESULT_BACKEND=redis://127.0.0.1:6379/1

# LLM — Local pool (mlx-lm on Apple Silicon)
DOOWON_LLM_LOCAL_PROVIDER=mlx-lm
DOOWON_LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
DOOWON_LLM_LOCAL_API_KEY=mlx
DOOWON_LLM_LOCAL_DEFAULT_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
DOOWON_LLM_LOCAL_CANONICAL_MODEL=qwen/qwen3.6-35b-a3b
DOOWON_LLM_LOCAL_LONG_GENERATION_TIMEOUT_SECONDS=1200

# LLM — External pool (OpenRouter)
DOOWON_LLM_EXTERNAL_ENABLED=true
DOOWON_LLM_EXTERNAL_PROVIDER=openrouter
DOOWON_LLM_EXTERNAL_BASE_URL=https://openrouter.ai/api/v1
DOOWON_LLM_EXTERNAL_DEFAULT_MODEL=openai/gpt-5.4-mini
DOOWON_LLM_EXTERNAL_CANONICAL_MODEL=openai/gpt-5.4-mini
DOOWON_LLM_EXTERNAL_LONG_GENERATION_TIMEOUT_SECONDS=900

# LLM — shared
DOOWON_LLM_HEALTHCHECK_ON_STARTUP=true
DOOWON_LLM_REQUIRED=true
DOOWON_LLM_REQUEST_TIMEOUT_SECONDS=60
DOOWON_EMBEDDING_PROVIDER=openrouter
DOOWON_RERANKER_PROVIDER=replicate
DOOWON_OCR_PRIMARY_PROVIDER=openrouter
DOOWON_OCR_FALLBACK_PROVIDER=replicate
DOOWON_OCR_SECONDARY_PROVIDER=custom
DOOWON_LLM_EXTERNAL_API_KEY=
DOOWON_LLM_EXTERNAL_BASE_URL=https://openrouter.ai/api/v1
DOOWON_REPLICATE_API_TOKEN=
DOOWON_REPLICATE_BASE_URL=https://api.replicate.com/v1
# Optional compatibility for Replicate SDK/CLI. Keep this value aligned with DOOWON_REPLICATE_API_TOKEN.
REPLICATE_API_TOKEN=
DOOWON_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
DOOWON_RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
DOOWON_REPLICATE_RERANKER_MODEL=tejasunku/qwen3-reranker-8b
DOOWON_OCR_PRIMARY_ENGINE=Qwen3-VL-8B-Thinking
DOOWON_OCR_FALLBACK_ENGINE=DeepSeek-OCR
DOOWON_OCR_SECONDARY_ENGINE=PaddleOCR-VL-1.5
DOOWON_REPLICATE_OCR_FALLBACK_MODEL=lucataco/deepseek-ocr
DOOWON_CUSTOM_OCR_SECONDARY_PROVIDER=huggingface-endpoints
DOOWON_CUSTOM_OCR_SECONDARY_MODEL=PaddlePaddle/PaddleOCR-VL-1.5

# Shared infrastructure
DOOWON_POSTGRES_DSN=postgresql+psycopg://aidoo_db:aidoo_db@127.0.0.1:5432/doowon_ai_portal
DOOWON_REDIS_URL=redis://127.0.0.1:6379/0
DOOWON_API_COLLAB_REDIS_URL=redis://127.0.0.1:6379/0
DOOWON_API_COLLAB_ACL_RECHECK_SECONDS=15
DOOWON_API_COLLAB_SNAPSHOT_DEBOUNCE_MS=2000
DOOWON_API_DB_POOL_SIZE=10
DOOWON_API_DB_MAX_OVERFLOW=20
DOOWON_API_DB_POOL_TIMEOUT=30
DOOWON_DEV_USE_LOCAL_POSTGRES=auto
DOOWON_DEV_USE_LOCAL_MINIO=auto
DOOWON_OPENSEARCH_URL=http://127.0.0.1:9200
AIDOO_QDRANT_URL=http://127.0.0.1:6333
DOOWON_MINIO_ENDPOINT=http://127.0.0.1:9000
DOOWON_MINIO_ACCESS_KEY=minioadmin
DOOWON_MINIO_SECRET_KEY=minioadmin
DOOWON_MINIO_BUCKET=aidoo-portal

# Phase 5 RAG
# Toggle is read at process startup. Changing it requires API/worker restart.
# Production should set this explicitly instead of relying on defaults.
AIDOO_RAG_ENABLED=true
AIDOO_VECTOR_INDEX_PROVIDER=qdrant
AIDOO_EMBEDDING_PROVIDER=deepinfra
AIDOO_RERANK_PROVIDER=deepinfra
AIDOO_OCR_PROVIDER=fake
AIDOO_QDRANT_API_KEY=
AIDOO_QDRANT_COLLECTION_PREFIX=doowon-rag

# DeepInfra (fallback aliases: DEEPINFRA_*)
AIDOO_DEEPINFRA_API_KEY=
AIDOO_DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
AIDOO_DEEPINFRA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
AIDOO_DEEPINFRA_RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
AIDOO_DEEPINFRA_TIMEOUT=60

# Recording ASR
DOOWON_API_ASR_BACKEND=deepinfra
DOOWON_API_ASR_DEEPINFRA_API_KEY=
DOOWON_API_ASR_DEEPINFRA_MODEL=openai/whisper-large-v3
DOOWON_API_ASR_DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/inference
DOOWON_API_ASR_REQUEST_TIMEOUT_SECONDS=600

# Image Wizard
# Requires an OpenAI-compatible image generation API key. The VM worker must
# listen to the image_generation queue.
DOOWON_IMAGE_ENABLED=false
DOOWON_IMAGE_API_KEY=
DOOWON_IMAGE_BASE_URL=https://api.openai.com/v1
DOOWON_IMAGE_MODEL=gpt-image-2
DOOWON_IMAGE_SUPERVISOR_MODEL=gpt-5.5
DOOWON_IMAGE_BRIEF_WEB_SEARCH_ENABLED=true
DOOWON_IMAGE_AGENT_WEB_SEARCH_ENABLED=true
DOOWON_IMAGE_AGENT_MAX_ITER=10
