OPEN_WORK_HUB_LLM_LOCAL_PROVIDER=docker-model-runner
OPEN_WORK_HUB_LLM_REQUEST_TIMEOUT_SECONDS=60
OPEN_WORK_HUB_LLM_REQUIRED=true
HF_TOKEN=

# AI runtime, policy, and agent execution
OPEN_WORK_HUB_AI_AGENT_MAX_CONSECUTIVE_TOOL_ERRORS=3
OPEN_WORK_HUB_AI_AGENT_MAX_TOOL_CALLS=16
OPEN_WORK_HUB_AI_AGENT_MAX_TURNS=8
