VITE_OPEN_ALM_DESKTOP_INSTALLER_URL_MAC=/api/v1/open-alm-desktop/updates/mac/Open ALM-Desktop-latest.dmg
VITE_OPEN_ALM_DESKTOP_INSTALLER_URL_WIN=/api/v1/open-alm-desktop/updates/win/Open ALM-Desktop-Setup-latest.exe

