# Open Work Hub environment
# Canonical env contract. Keep dev/prod/local/example keysets and order identical.
# Values may differ by environment; do not print secrets in logs.

# Runtime identity, API entrypoint, and web development
OPEN_WORK_HUB_API_ALLOW_DEV_ADMIN_LOGIN=1
OPEN_WORK_HUB_API_APP_NAME=Open Work Hub API
OPEN_WORK_HUB_API_DEV_LOGIN_ALLOWED_HOSTS=
OPEN_WORK_HUB_API_DEV_LOGIN_PASSWORD=open-work-hub-dev-only
OPEN_WORK_HUB_API_DEV_PORT=8001
OPEN_WORK_HUB_API_ENVIRONMENT=development
OPEN_WORK_HUB_API_FRONTEND_DIST_DIR=
OPEN_WORK_HUB_API_INSTANCE_ID=dev-api
OPEN_WORK_HUB_API_OBJECT_STORAGE_REQUIRED=true
OPEN_WORK_HUB_API_PREFIX=/api/v1
OPEN_WORK_HUB_API_SEED_DEV_LOGIN_ACCOUNT=true
OPEN_WORK_HUB_API_SERVE_FRONTEND=false
OPEN_WORK_HUB_API_SESSION_TTL_HOURS=168
OPEN_WORK_HUB_ENV_PROFILE=dev
OPEN_WORK_HUB_WEB_API_PROXY_TARGET=http://127.0.0.1:8001
OPEN_WORK_HUB_WEB_DEV_ALLOWED_HOSTS=
OPEN_WORK_HUB_WEB_DEV_HOST=127.0.0.1
OPEN_WORK_HUB_WEB_DEV_PORT=4200
COMPOSE_PROJECT_NAME=open-work-hub-dev

# Desktop updates
OPEN_WORK_HUB_DESKTOP_UPDATE_LINUX_DIR=.open-work-hub-desktop-updates/linux
OPEN_WORK_HUB_DESKTOP_UPDATE_MAC_DIR=.open-work-hub-desktop-updates/mac
OPEN_WORK_HUB_DESKTOP_UPDATE_WIN_DIR=.open-work-hub-desktop-updates/win
VITE_OPEN_WORK_HUB_DESKTOP_INSTALLER_URL_LINUX=/api/v1/open-work-hub-desktop/updates/linux/Open Work Hub-Desktop-latest.deb
VITE_OPEN_WORK_HUB_DESKTOP_INSTALLER_URL_MAC=/api/v1/open-work-hub-desktop/updates/mac/Open Work Hub-Desktop-latest.dmg
VITE_OPEN_WORK_HUB_DESKTOP_INSTALLER_URL_WIN=/api/v1/open-work-hub-desktop/updates/win/Open Work Hub-Desktop-Setup-latest.exe

# Infrastructure containers and published ports
OPEN_WORK_HUB_INFRA_BIND_HOST=127.0.0.1
OPEN_WORK_HUB_INFRA_CONTAINER_PREFIX=open-work-hub-dev
OPEN_WORK_HUB_INFRA_MINIO_CONSOLE_PORT=59011
OPEN_WORK_HUB_INFRA_MINIO_PORT=59010
OPEN_WORK_HUB_INFRA_MINIO_ROOT_PASSWORD=open_work_hub_dev_minio
