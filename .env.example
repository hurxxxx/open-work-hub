# Open ALM environment
# Canonical env contract. Keep dev/prod/local/example keysets and order identical.
# Values may differ by environment; do not print secrets in logs.

# Runtime identity, API entrypoint, and web development
OPEN_ALM_API_ALLOW_DEV_ADMIN_LOGIN=1
OPEN_ALM_API_APP_NAME=Open ALM API
OPEN_ALM_API_DEV_LOGIN_ALLOWED_HOSTS=
OPEN_ALM_API_DEV_PORT=8001
OPEN_ALM_API_ENVIRONMENT=development
OPEN_ALM_API_FRONTEND_DIST_DIR=
OPEN_ALM_API_INSTANCE_ID=dev-api
OPEN_ALM_API_PREFIX=/api/v1
OPEN_ALM_API_SERVE_FRONTEND=false
OPEN_ALM_API_SESSION_TTL_HOURS=168
OPEN_ALM_ENV_PROFILE=dev
OPEN_ALM_WEB_API_PROXY_TARGET=http://127.0.0.1:8001
OPEN_ALM_WEB_DEV_PORT=4200
COMPOSE_PROJECT_NAME=open-alm-dev

# Desktop updates
OPEN_ALM_DESKTOP_UPDATE_LINUX_DIR=.open-alm-desktop-updates/linux
