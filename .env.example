OPEN_WORK_HUB_BENTO_PORT=18084
OPEN_WORK_HUB_BENTO_SERVER_URL=http://127.0.0.1:18084/

# LLM providers
OPEN_WORK_HUB_LLM_EXTERNAL_ALLOWED_PROVIDERS=openai,anthropic,gemini
