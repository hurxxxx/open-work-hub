  "responsibility": "시나리오 계약, eval, trace, release gate, adapter projection, helper selection 로직을 소유한다.",
  "scenario_candidates": [
    "documents-rag",
    "plm-query",
    "draft-generation",
    "ocr-pipeline",
    "wiki-pms"
  ],
  "must_read_docs": [
    "docs/agents/context-loading-policy.md",
