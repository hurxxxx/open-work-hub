{
  "$schema": "https://doowon.local/docs/harness/schemas/domain-rule-manifest.schema.json",
  "domain_id": "shared-harness",
  "path_prefixes": [
    "docs/harness/",
    "docs/agents/",
    "docs/ops/",
    "CLAUDE.md",
    "agents.md",
    "apps/api/AGENTS.md",
    "apps/web/AGENTS.md",
    "apps/worker/AGENTS.md",
    "apps/ops/AGENTS.md",
    ".claude/commands/",
    ".claude/rules/",
    ".claude/hooks/",
    ".codex/skills/doowon-harness-engineering/"
