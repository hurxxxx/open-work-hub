{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doowon.local/docs/harness/schemas/scenario-manifest.schema.json",
  "title": "ScenarioManifest",
  "type": "object",
  "required": [
    "scenario_id",
    "goal",
    "domain_ids",
    "source_doc",
    "workflow_bundle",
    "eval_suite",
    "trace_grade_spec",
    "must_read_docs",
    "optional_support_docs",
    "do_not_load_by_default",
    "allowed_tools",
    "guardrail_policies"
  ],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "domain_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_doc": { "type": "string", "minLength": 1 },
    "workflow_bundle": { "type": "string", "minLength": 1 },
    "eval_suite": { "type": "string", "minLength": 1 },
    "trace_grade_spec": { "type": "string", "minLength": 1 },
    "must_read_docs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "optional_support_docs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "do_not_load_by_default": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "guardrail_policies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "release_gate": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
