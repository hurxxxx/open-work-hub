{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doowon.local/docs/harness/schemas/prompt-bundle.schema.json",
  "title": "PromptBundle",
  "type": "object",
  "required": [
    "scenario_id",
    "workflow_version",
    "prompt_templates"
  ],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "workflow_version": { "type": "string", "minLength": 1 },
    "prompt_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "template_id",
          "stage",
          "prompt_version",
          "fixed_instruction_path",
          "variable_slots",
          "context_contract"
        ],
        "properties": {
          "template_id": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "prompt_version": { "type": "string", "minLength": 1 },
          "fixed_instruction_path": { "type": "string", "minLength": 1 },
          "variable_slots": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "context_contract": {
            "type": "object",
            "required": ["load", "avoid"],
            "properties": {
              "load": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "avoid": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
