{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doowon.local/docs/harness/schemas/eval-suite.schema.json",
  "title": "EvalSuite",
  "type": "object",
  "required": [
    "scenario_id",
    "eval_profile",
    "runner",
    "datasets",
    "graders",
    "promptfoo_config"
  ],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "eval_profile": { "type": "string", "minLength": 1 },
    "runner": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "secondary": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "required_for_release"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "required_for_release": { "type": "boolean" },
          "purpose": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "type", "threshold"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "threshold": {},
          "blocking": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "promptfoo_config": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
