{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doowon.local/docs/harness/schemas/trace-event.schema.json",
  "title": "TraceEvent",
  "type": "object",
  "required": [
    "trace_id",
    "scenario_id",
    "workflow_version",
    "prompt_version",
    "retrieval_profile",
    "llm_profile",
    "eval_profile",
    "user_role",
    "acl_scope",
    "status",
    "started_at",
    "ended_at"
  ],
  "properties": {
    "trace_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "workflow_version": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "retrieval_profile": { "type": "string", "minLength": 1 },
    "llm_profile": { "type": "string", "minLength": 1 },
    "eval_profile": { "type": "string", "minLength": 1 },
    "user_role": { "type": "string", "minLength": 1 },
    "acl_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["success", "fallback", "blocked", "failed"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
