{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doowon.local/docs/harness/schemas/context-selection-result.schema.json",
  "title": "ContextSelectionResult",
  "type": "object",
  "required": [
    "scenario_id",
    "must_read_docs",
    "optional_support_docs",
    "do_not_load_by_default"
  ],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "resolved_domain": { "type": "string" },
    "confidence": { "type": "string" },
    "must_read_docs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "optional_support_docs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "do_not_load_by_default": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
