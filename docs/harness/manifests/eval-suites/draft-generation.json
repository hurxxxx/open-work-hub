{
  "$schema": "https://doowon.local/docs/harness/schemas/eval-suite.schema.json",
  "scenario_id": "draft-generation",
  "eval_profile": "draft-generation-eval-v1",
  "runner": {
    "primary": "promptfoo",
    "secondary": []
  },
  "datasets": [
    {
      "name": "golden",
      "path": "docs/harness/evals/datasets/draft-generation/golden.jsonl",
      "required_for_release": true,
      "purpose": "핵심 템플릿/초안 품질"
    },
    {
      "name": "shadow",
      "path": "docs/harness/evals/datasets/draft-generation/shadow.jsonl",
      "required_for_release": true,
      "purpose": "실패 사례 재현"
    },
    {
      "name": "adversarial",
      "path": "docs/harness/evals/datasets/draft-generation/adversarial.jsonl",
      "required_for_release": false,
      "purpose": "unsupported claim 및 export 예외"
    }
  ],
  "graders": [
    { "metric": "template_field_fill_rate", "type": "field-coverage", "threshold": 0.95, "blocking": true },
    { "metric": "citation_block_attachment", "type": "rule-check", "threshold": 0.98, "blocking": true },
    { "metric": "unsupported_claim_rate", "type": "llm-rubric", "threshold": 0.05, "blocking": true },
    { "metric": "export_success_rate", "type": "job-outcome", "threshold": 0.99, "blocking": true }
  ],
  "promptfoo_config": "docs/harness/evals/promptfoo/scenarios/draft-generation.yaml"
}
