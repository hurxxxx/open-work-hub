{
  "$schema": "https://doowon.local/docs/harness/schemas/scenario-manifest.schema.json",
  "scenario_id": "ocr-pipeline",
  "goal": "원문 추출과 OCR 라우팅을 통해 검색과 초안 작성에 사용할 표준화 텍스트와 레이아웃 메타데이터를 만든다.",
  "domain_ids": ["ocr"],
  "keywords": ["ocr", "layout", "scan", "image", "pdf", "표", "추출"],
  "source_doc": "docs/harness/scenarios/ocr-pipeline.md",
  "workflow_bundle": "docs/harness/prompt-bundles/ocr-pipeline/workflow.json",
  "eval_suite": "docs/harness/manifests/eval-suites/ocr-pipeline.json",
  "trace_grade_spec": "docs/harness/manifests/trace-grade-specs/ocr-pipeline.json",
  "release_gate": "docs/ops/release-gates-and-alerts.md",
  "must_read_docs": [
    "agents.md",
    "docs/agents/context-loading-policy.md",
    "docs/agents/agent-operating-standard.md",
    "docs/harness/scenarios/ocr-pipeline.md",
    "docs/harness/manifests/scenarios/ocr-pipeline.json",
    "docs/harness/prompt-bundles/ocr-pipeline/workflow.json"
  ],
  "optional_support_docs": [
    "docs/harness/eval-regression-spec.md",
    "docs/harness/service-runtime-harness.md",
    "docs/harness/trace-and-scorecard-spec.md",
    "docs/ops/release-gates-and-alerts.md"
  ],
  "do_not_load_by_default": [
    "docs/harness/scenarios/documents-rag.md",
    "docs/harness/scenarios/plm-query.md",
    "docs/harness/scenarios/draft-generation.md",
    "docs/harness/scenarios/wiki-pms.md"
  ],
  "allowed_tools": [
    "Native extractor",
    "OCR need classifier",
    "OCR engine router",
    "Qwen3-VL-8B-Thinking",
    "DeepSeek-OCR",
    "PaddleOCR-VL-1.5",
    "Normalizer",
    "Quality judge"
  ],
  "guardrail_policies": [
    "catastrophic_ocr_failure_block",
    "fallback_route_required",
    "quality_threshold_required"
  ],
  "expected_artifacts": [
    "ScenarioManifest update",
    "Engine routing review",
    "TraceGradeSpec refresh",
    "Promptfoo benchmark coverage review"
  ]
