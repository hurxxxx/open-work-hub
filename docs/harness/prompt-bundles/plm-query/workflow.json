{
  "$schema": "https://doowon.local/docs/harness/schemas/prompt-bundle.schema.json",
  "scenario_id": "plm-query",
  "workflow_version": "plm-query-wf-v1",
  "prompt_templates": [
    {
      "template_id": "plm-query-intent",
      "stage": "intent-routing",
      "prompt_version": "plm-query-prompt-v1",
      "fixed_instruction_path": "docs/harness/prompt-bundles/plm-query/intent.md",
      "variable_slots": ["query", "constraints"],
      "context_contract": {
        "load": ["user_query", "constraints"],
        "avoid": ["documents_rag_context", "pms_context"]
      }
    },
    {
      "template_id": "plm-query-planning",
      "stage": "generation",
      "prompt_version": "plm-query-prompt-v1",
      "fixed_instruction_path": "docs/harness/prompt-bundles/plm-query/planning.md",
      "variable_slots": ["query", "template_candidates", "allowlist"],
      "context_contract": {
        "load": ["template_candidates", "allowlist", "read_only_rules"],
        "avoid": ["executor_results", "other_domain_docs"]
      }
    },
    {
      "template_id": "plm-query-summarizer",
      "stage": "export",
      "prompt_version": "plm-query-prompt-v1",
      "fixed_instruction_path": "docs/harness/prompt-bundles/plm-query/summarizer.md",
      "variable_slots": ["result_table", "query_plan"],
      "context_contract": {
        "load": ["result_table", "applied_filters"],
        "avoid": ["planner_chain_of_thought"]
      }
    },
    {
      "template_id": "plm-query-policy",
      "stage": "policy-check",
      "prompt_version": "plm-query-prompt-v1",
      "fixed_instruction_path": "docs/harness/prompt-bundles/plm-query/policy.md",
      "variable_slots": ["sql_preview", "validator_result", "acl_result"],
      "context_contract": {
        "load": ["validator_result", "allowlist", "acl_result"],
        "avoid": ["unapproved_sql_variants"]
      }
    }
  ]
}
