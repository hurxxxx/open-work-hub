{
  "feedPathPrefix": "/api/v1/ai-do-desktop/updates",
  "updateBaseUrlEnv": "AI_DO_DESKTOP_UPDATE_BASE_URL",
  "trustedUpdateOriginsEnv": "AI_DO_DESKTOP_TRUSTED_UPDATE_ORIGINS",
  "servedArtifactContentTypes": {
    ".deb": "application/vnd.debian.binary-package",
    ".dmg": "application/x-apple-diskimage",
    ".exe": "application/octet-stream",
    ".zip": "application/zip"
  },
  "platformOrder": ["win", "mac", "linux"],
  "platforms": {
    "win": {
      "packageName": "ai-do-desktop-win",
      "installerUrlEnv": "VITE_AI_DO_DESKTOP_INSTALLER_URL_WIN",
      "installerStableCopy": "AI-DO-Desktop-Setup-latest.exe",
      "updateDirEnv": "AI_DO_DESKTOP_UPDATE_WIN_DIR",
      "defaultDir": ".ai-do-desktop-updates/win",
      "updateFile": "latest.yml",
      "servedArtifactSuffixes": [".exe", ".blockmap"],
      "packagedArtifacts": [
        {
          "template": "AI-DO Desktop Setup ${version}.exe"
        },
        {
          "template": "AI-DO Desktop Setup ${version}.exe.blockmap"
        }
      ],
      "stableCopies": [
        {
          "template": "AI-DO Desktop Setup ${version}.exe",
          "to": "AI-DO-Desktop-Setup-latest.exe"
        }
      ]
    },
    "mac": {
      "packageName": "ai-do-desktop-mac",
      "installerUrlEnv": "VITE_AI_DO_DESKTOP_INSTALLER_URL_MAC",
      "installerStableCopy": "AI-DO-Desktop-latest.dmg",
      "updateDirEnv": "AI_DO_DESKTOP_UPDATE_MAC_DIR",
      "defaultDir": ".ai-do-desktop-updates/mac",
      "updateFile": "latest-mac.yml",
      "servedArtifactSuffixes": [".dmg", ".zip", ".blockmap"],
      "packagedArtifacts": [
        {
          "prefixTemplate": "AI-DO-Desktop-${version}-mac-"
        }
      ],
      "stableCopies": [
        {
          "prefixTemplate": "AI-DO-Desktop-${version}-mac-",
          "suffix": ".dmg",
          "to": "AI-DO-Desktop-latest.dmg"
        },
        {
          "prefixTemplate": "AI-DO-Desktop-${version}-mac-",
          "suffix": ".zip",
          "to": "AI-DO-Desktop-latest-mac.zip"
        }
      ]
    },
    "linux": {
      "packageName": "ai-do-desktop-linux",
      "installerUrlEnv": "VITE_AI_DO_DESKTOP_INSTALLER_URL_LINUX",
      "installerStableCopy": "AI-DO-Desktop-latest.deb",
      "updateDirEnv": "AI_DO_DESKTOP_UPDATE_LINUX_DIR",
      "defaultDir": ".ai-do-desktop-updates/linux",
      "updateFile": "latest-linux.yml",
      "servedArtifactSuffixes": [".deb", ".blockmap"],
      "packagedArtifacts": [
        {
          "prefixTemplate": "AI-DO-Desktop-${version}-linux-",
          "suffix": ".deb"
        }
      ],
      "stableCopies": [
        {
          "prefixTemplate": "AI-DO-Desktop-${version}-linux-",
          "suffix": ".deb",
          "to": "AI-DO-Desktop-latest.deb"
        }
      ]
    }
  }
}
