{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["$schema", "apps"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./app-contracts.schema.json"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "app_id",
          "title",
          "icon_key",
          "execution_context_kind",
          "resource_scope",
          "route_base",
          "entry_route_id",
          "launcher",
          "routes"
        ],
        "properties": {
          "app_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "icon_key": {
            "type": "string",
            "minLength": 1
          },
          "execution_context_kind": {
            "enum": ["personal", "company"]
          },
          "resource_scope": {
            "enum": ["personal", "company", "hybrid"]
          },
          "route_base": {
            "type": "string",
            "pattern": "^/apps/[a-z0-9-]+$"
          },
          "entry_route_id": {
            "type": "string",
            "minLength": 1
          },
          "launcher": {
            "type": "object",
            "additionalProperties": false,
            "required": ["placement", "pinned_by_default"],
            "properties": {
              "placement": {
                "enum": ["fixed", "personal_tools", "category"]
              },
              "pinned_by_default": {
                "type": "boolean"
              }
            }
          },
          "feature_flag": {
            "type": "string",
            "minLength": 1
          },
          "required_system_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["route_id", "suffix", "chrome"],
              "properties": {
                "route_id": {
                  "type": "string",
                  "minLength": 1
                },
                "suffix": {
                  "type": "string"
                },
                "chrome": {
                  "enum": [
                    "standard",
                    "containedSurface",
                    "fullSurface",
                    "shared"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
