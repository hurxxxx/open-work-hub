{
  "name": "core-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core-web/src",
  "projectType": "library",
  "tags": ["scope:web", "type:lib", "domain:core"],
  "// targets": "to see all targets run: nx show project core-web --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm --dir packages/core-web build",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec tsc -p packages/core-web/tsconfig.lib.json --noEmit",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec vitest run packages/core-web/src",
        "cwd": "."
      }
    }
  }
}
