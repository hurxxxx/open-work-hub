{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [
    "coverage/**",
    "dist/**",
    "node_modules/**"
  ],
  "rules": {
    "dependencies": "off",
    "devDependencies": "off",
    "unlisted": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "apps/web/src/main.tsx",
        "apps/web/src/App.tsx",
        "apps/web/src/app/AppRoot.tsx",
        "apps/web/vite.config.mts",
        "apps/web/playwright.config.ts",
        "packages/ui/src/index.ts",
        "packages/ui/styles.css",
        "packages/ui/vite.config.mts",
        "eslint.config.mjs",
        "scripts/blocknote-collab-codec.mjs",
        "scripts/check-contracts-publish-tag.mjs",
        "scripts/run-affected-api-tests.mjs",
        "scripts/check-web-app-boundaries.mjs"
      ],
      "paths": {
        "@/src/*": [
          "apps/web/src/*"
        ],
        "@open-alm/ui": [
          "packages/ui/src/index.ts"
        ],
        "@open-alm/ui/styles.css": [
          "packages/ui/styles.css"
        ],
        "@open-alm/web-shell": [
          "apps/web/src/app/shell/AppContent.tsx"
        ],
        "@open-alm/web/styles.css": [
          "apps/web/src/index.css"
        ],
        "@open-alm/web/fullcalendar-theme.css": [
          "apps/web/src/styles/fullcalendar-theme.css"
        ]
      },
      "project": [
        "*.cjs",
        "*.mjs",
        "scripts/**/*.mjs"
      ]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx",
        "src/App.tsx",
        "src/app/AppRoot.tsx",
        "vite.config.mts",
        "playwright.config.ts"
      ],
      "ignore": [
        "src/**/*.spec.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "src/test-setup.ts",
        "tests/**"
      ],
      "paths": {
        "@/src/*": [
          "src/*"
        ],
        "@open-alm/ui": [
          "../../packages/ui/src/index.ts"
        ],
        "@open-alm/ui/styles.css": [
          "../../packages/ui/styles.css"
        ],
        "@open-alm/web-shell": [
          "../web/src/app/shell/AppContent.tsx"
        ],
        "@open-alm/web/styles.css": [
          "../web/src/index.css"
        ],
        "@open-alm/web/fullcalendar-theme.css": [
          "../web/src/styles/fullcalendar-theme.css"
        ]
      },
      "project": [
        "*.config.{ts,mts}",
        "playwright.config.ts",
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "vite.config.mts"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/index.ts",
        "styles.css"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "styles.css"
      ]
    }
  }
}
