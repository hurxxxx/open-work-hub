{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@aidoo/ui": ["packages/ui/src/index.ts"],
      "@aidoo/ui/*": ["packages/ui/src/lib/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
